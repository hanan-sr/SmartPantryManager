<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="#F4F8F3">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Recipes you can make" android:textSize="24sp" android:textStyle="bold" android:textColor="#1B5E20"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Only recipes with every required ingredient and quantity in your pantry are shown."
        android:textColor="#526653" android:paddingTop="6dp" android:paddingBottom="12dp"/>
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No recipes match your pantry yet. Add more ingredients to unlock recipes."
        android:textColor="#526653" android:padding="18dp" android:gravity="center" android:visibility="gone"/>
    <ListView android:id="@+id/recipeList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="#DCE8DC" android:dividerHeight="8dp"/>
    <Button android:id="@+id/backButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back to pantry"/>
</LinearLayout>
